# ── 部署模式：二选一 ──
# 1) AI Studio 托管模式（无需自建 vLLM）：
AI_STUDIO_TOKEN=
# AI_STUDIO_MODEL=PaddleOCR-VL-1.6

# 2) 本地 vLLM 模式：
# VLLM_SERVER_URL=http://your-vllm-server:8000/v1
# 使用 docker compose --profile vllm 内置 vLLM 时保持默认 http://vllm:8000/v1 即可

# ── 通用 ──
HOST_PORT=8399
JWT_SECRET=change-me-to-a-long-random-string
MAX_BATCH_WORKERS=2
