# ── 部署模式（二选一）──
# 设置 AI_STUDIO_TOKEN 后，扫描件 PDF / 图片走 AI Studio 托管 API，
# 无需自建 vLLM。留空则走本地 vLLM 模式。
AI_STUDIO_TOKEN=

# 本地 vLLM 模式：指向内置 vllm 服务（默认）或外部 vLLM 地址
# VLLM_SERVER_URL=http://your-vllm-host:8000/v1

# ── 容器内路径（需与 docker-compose.yaml 中 volumes 挂载点一致，一般无需修改）──
# 注意：修改 UPLOAD_DIR 时必须同步修改 JOBS_DIR 和 volumes 挂载点
UPLOAD_DIR=/app/data/uploads
JOBS_DIR=/app/data/uploads/jobs
USER_DB_PATH=/app/data/user.json

# ── 通用 ──
# JWT 密钥：改成随机长字符串并保持稳定（改动会使旧 token 失效）
JWT_SECRET=change-me-in-production
MAX_BATCH_WORKERS=2
AI_STUDIO_MODEL=PaddleOCR-VL-1.6
AI_STUDIO_TIMEOUT=1800
ARCHIVE_RESULT_TTL_SECONDS=604800
